# =============================================================================
# Campus360 Hub — variables de entorno
# Copia este archivo: cp .env.example .env.local
# =============================================================================

# URL pública de la app (producción / QStash). En local suele bastar el default.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo desarrollo: fuerza horario abierto (open | lunch | after-hours). No usar en prod.
NEXT_PUBLIC_MOCK_BUSINESS_HOURS=open

# -----------------------------------------------------------------------------
# Upstash Redis (turnos, caché de avisos, categorías y horarios)
# Alternativa en Vercel KV: KV_REST_API_URL + KV_REST_API_TOKEN
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# KV_REST_API_URL=https://your-kv.upstash.io
# KV_REST_API_TOKEN=your_kv_rest_token

# -----------------------------------------------------------------------------
# Upstash QStash (cola de turnos en producción; en local se llama PA directo)
# -----------------------------------------------------------------------------
QSTASH_TOKEN=your_qstash_token

# -----------------------------------------------------------------------------
# Microsoft Power Automate — webhooks
# -----------------------------------------------------------------------------
PA_CREAR_TURNO_URL=https://prod-xxx.logic.azure.com/workflows/.../triggers/manual/paths/invoke
PA_CREAR_AUTOGESTION_URL=https://prod-xxx.logic.azure.com/workflows/.../triggers/manual/paths/invoke
PA_CREAR_FUERA_HORARIO_URL=https://prod-xxx.logic.azure.com/workflows/.../triggers/manual/paths/invoke
PA_ACTUALIZAR_TURNO_URL=https://prod-xxx.logic.azure.com/workflows/.../triggers/manual/paths/invoke

# Banner / avisos (SharePoint vía Power Automate)
MICROSOFT_AVISOS_FLOW_URL=https://prod-xxx.logic.azure.com/workflows/.../triggers/manual/paths/invoke

# Categorías del wizard (SharePoint vía Power Automate, fallback si Redis vacío)
MICROSOFT_CATEGORIAS_FLOW_URL=https://prod-xxx.logic.azure.com/workflows/.../triggers/manual/paths/invoke

# Secret compartido para POST refresh (banner, categorías y horarios)
# Header: Authorization: Bearer <REFRESH_SECRET>
REFRESH_SECRET=your_long_random_secret

# -----------------------------------------------------------------------------
# Zoom (ID de reunión para enlaces deep link y web)
# -----------------------------------------------------------------------------
ZOOM_MEETING_ID=89419717339
